{
  "permissions": {
    "allow": [
      "Bash(python -m pytest *)",
      "Bash(ruff check *)",
      "Bash(ruff format *)",
      "Bash(mypy *)",
      "Bash(tach check *)",
      "Bash(tach show *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(wc *)",
      "Bash(ls *)",
      "Bash(tree *)",
      "Read(src/*)",
      "Read(tests/*)",
      "Read(docs/*)",
      "Read(specs/*)",
      "Read(.agents/*)",
      "Read(.claude/*)",
      "Read(alembic/*)",
      "Read(scripts/*)",
      "Read(pyproject.toml)",
      "Read(tach.toml)",
      "Read(CLAUDE.md)",
      "Read(CONSTITUTION.md)",
      "Read(CONTRIBUTING.md)",
      "Read(README.md)",
      "Read(.gitignore)",
      "Read(context.yaml)",
      "Read(compose.yaml)",
      "Read(pyrightconfig.json)",
      "Write(src/*)",
      "Write(tests/*)",
      "Write(docs/*)",
      "Write(.tmp/*)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard *)",
      "Bash(git force *)",
      "Bash(rm -rf *)",
      "Bash(del /s *)",
      "Bash(pip install *)",
      "Bash(npm install *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(Invoke-WebRequest *)",
      "Read(.env)",
      "Read(.env.*)",
      "Write(.env)",
      "Write(.env.*)",
      "Write(pyproject.toml)",
      "Write(uv.lock)",
      "Write(alembic.ini)",
      "Write(.claude/settings.json)",
      "Bash(git stash *)",
      "Bash(gh *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(rm -fR *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Bash(rm --recursive *)",
      "Bash(nc *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git clone *)",
      "Bash(env)",
      "Bash(printenv *)",
      "Bash(*_API_KEY*)",
      "Read(./.env)",
      "Read(**/.env)",
      "Read(~/.specweaver/keys.env)",
      "Read(~/.specweaver/db_roles.env)",
      "Bash(sw *)",
      "Bash(uv run sw *)",
      "Bash(git add *mutation_findings*)",
      "Bash(git commit *mutation_findings*)",
      "Bash(git add .)",
      "Bash(git add -A *)",
      "Bash(git add --all *)",
      "Bash(git commit -a *)",
      "Bash(git commit -am *)",
      "Bash(git commit --all *)"
    ],
    "ask": [
      "Bash(*.env*)",
      "Bash(*keys.env*)",
      "Bash(*db_roles.env*)",
      "Bash(*-m live*)",
      "Bash(*scripts/live.py*)",
      "Bash(uv pip *)",
      "Bash(uv add *)",
      "Bash(uv sync *)",
      "Bash(uv run *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.venv/bin/python \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_finished_stories.py",
            "timeout": 15,
            "statusMessage": "Guarding finished roadmap stories..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.venv/bin/python -c 'import json, subprocess, sys; p = json.load(sys.stdin).get(\"tool_input\", {}).get(\"file_path\", \"\"); p.endswith(\".py\") and subprocess.run([sys.argv[1], \"check\", \"--fix\", \"--quiet\", p])' \"$CLAUDE_PROJECT_DIR\"/.venv/bin/ruff || exit 0",
            "statusMessage": "Auto-fixing lint issues..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.venv/bin/python \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session_brief.py",
            "timeout": 10,
            "statusMessage": "Briefing on this repo's operational rules..."
          }
        ]
      }
    ]
  }
}
