      "requirement": "FR-1",
      "title": "The environment is built on a writable mount",
      "scope": [
        "tests/unit/sandbox/execution/test_container_executor_prepare.py"
      ],
      "mutants": [
        {
          "id": "venv-lands-in-the-read-only-workdir",
          "file": "src/specweaver/sandbox/execution/container_executor.py",
          "symbol": "ContainerSubprocessExecutor._prepare_container",
          "old": "f\"UV_PROJECT_ENVIRONMENT={_PREPARED_VENV}\",",
          "new": "\"UV_HTTP_TIMEOUT=60\",",
          "breaks": "uv falls back to `.venv` in the workdir, which is `/workspace:ro` — the phase then fails for every project on every layout before the manifest is read",
          "symbol_sha": "sha256:21164ed9de8b2a36112877a88eeb3ee763d489ed7e85064ff6d15f22313a14fc"
        }
      ]
    },
