          "new": "checksum=\"constant\",",
          "breaks": "an edited rubric reports the same checksum, so the audit trail records nothing"
        }
      ]
    },
    {
      "requirement": "FR-5",
      "title": "An override cannot break the response parser",
      "scope": [
        "tests/unit/core/flow/handlers/test_review_rubric_seam.py",
